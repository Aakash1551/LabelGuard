# ==============================================================================
# LabelGuard AI - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="LabelGuard AI"
API_V1_STR="/api/v1"
DEBUG=True

# Security & Authentication
# Generate secure key via: openssl rand -hex 32
SECRET_KEY=labelguard_super_secret_production_key_change_in_production_32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite Async default: sqlite+aiosqlite:///./labelguard.db
# PostgreSQL Async example: postgresql+asyncpg://postgres:postgres@localhost:5432/labelguard_db
DATABASE_URL=sqlite+aiosqlite:///./labelguard.db

# Storage
MEDIA_UPLOAD_DIR=./uploads/packaging
REPORT_OUTPUT_DIR=./uploads/reports

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Initial Superadmin Configuration (Created on startup if not present)
FIRST_SUPERUSER_EMAIL=admin@labelguard.ai
FIRST_SUPERUSER_PASSWORD=AdminSecurePassword123!
FIRST_SUPERUSER_FULLNAME="LabelGuard Chief Inspector"
